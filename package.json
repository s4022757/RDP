{
  "name": "libraries-against-loneliness-kiosk",
  "version": "1.0.0",
  "description": "Responsive Progressive Web App (PWA) kiosk interface for Libraries Against Loneliness with Supabase and TouchDesigner integration.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "start:bridge": "python3 touchdesigner/local_bridge_server.py",
    "serve": "npx serve -l 8080 .",
    "validate": "node -c scripts/*.js && python3 -m py_compile touchdesigner/touchdesigner_poll_script.py touchdesigner/local_bridge_server.py"
  },
  "keywords": [
    "pwa",
    "kiosk",
    "touchdesigner",
    "supabase",
    "wellbeing",
    "generative-art",
    "rmit"
  ],
  "author": "RMIT Swanston Library Wellbeing Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3"
  }
}
